# Supabase (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=

# Cache invalidation webhook (DB → /api/internal/revalidate)
REVALIDATE_SECRET=

# cron-job.org → /api/cron-tick
CRON_SECRET=

# Admin: kick off GitHub Actions (scraper import, broadcast push)
GITHUB_DISPATCH_TOKEN=

# Web Push (VAPID). Private key lives in the scraper/Actions secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: GIF picker in kecárna
NEXT_PUBLIC_GIPHY_API_KEY=

# Optional: log event-detail timings in Vercel function logs
# PERF_LOG=1
